# ============================================================
#  PROLANCE — .env.example
#
#  INSTRUCTIONS:
#  1. Copy this file: cp .env.example .env
#  2. Replace EVERY value between <...> with the real value
#  3. NEVER commit the .env file to Git
#  4. This .env.example file can be committed (no real keys)
# ============================================================


# ================================================================
#  SHARED — used by multiple microservices
# ================================================================

# JWT secret key — minimum 32 characters, generate with:
# openssl rand -base64 32
JWT_SECRET=<GENERATE_WITH_openssl_rand_-base64_32>

# Google OAuth2 — obtain at https://console.cloud.google.com
# Enable "Google+ API" and create OAuth2 credentials
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_OAUTH2_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH2_CLIENT_SECRET>

# Gmail SMTP — use an "App Password" (not your real password)
# Google Account → Security → 2-Step Verification → App Passwords
MAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD_16_CHARS>

# Groq AI — obtain at https://console.groq.com/keys
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_API_MODEL=llama-3.3-70b-versatile


# ================================================================
#  INFRASTRUCTURE — MySQL (shared database)
# ================================================================

MYSQL_ROOT_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>
MYSQL_ALLOW_EMPTY_PASSWORD=no


# ================================================================
#  INFRASTRUCTURE — Eureka Server  [port: 8761]
# ================================================================

EUREKA_PORT=8761
EUREKA_HOSTNAME=localhost


# ================================================================
#  INFRASTRUCTURE — API Gateway  [port: 8222]
# ================================================================

GATEWAY_PORT=8222
EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/


# ================================================================
#  USER SERVICE  [exposed port: 8091]
# ================================================================

USER_DB_URL=jdbc:mysql://mysql:3306/dev_users?createDatabaseIfNotExist=true
USER_DB_USERNAME=root
USER_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  PUBLICATION SERVICE  [exposed port: 8092]
# ================================================================

PUBLICATION_DB_URL=jdbc:mysql://mysql:3306/dev_publication?createDatabaseIfNotExist=true
PUBLICATION_DB_USERNAME=root
PUBLICATION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>

# Jaeger tracing — use "localhost" locally, container name in Docker
JAEGER_HOST=localhost


# ================================================================
#  COMMENT SERVICE  [exposed port: 8093]
#  Shares JAEGER_HOST defined above
# ================================================================

COMMENTAIRE_DB_URL=jdbc:mysql://mysql:3306/dev_commentaire?createDatabaseIfNotExist=true
COMMENTAIRE_DB_USERNAME=root
COMMENTAIRE_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  REACTION SERVICE  [exposed port: 8094]
#  Shares JAEGER_HOST defined above
# ================================================================

REACTION_DB_URL=jdbc:mysql://mysql:3306/dev_reaction?createDatabaseIfNotExist=true
REACTION_DB_USERNAME=root
REACTION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  PROMO SERVICE  [exposed port: 8095]
# ================================================================

PROMO_DB_URL=jdbc:mysql://mysql:3306/dev_promo?createDatabaseIfNotExist=true
PROMO_DB_USERNAME=root
PROMO_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  SUBSCRIPTION SERVICE  [exposed port: 8096]
# ================================================================

SUBSCRIPTION_DB_URL=jdbc:mysql://mysql:3306/dev_subscription?createDatabaseIfNotExist=true
SUBSCRIPTION_DB_USERNAME=root
SUBSCRIPTION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>

# OpenAI — obtain at https://platform.openai.com/api-keys
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.7

# Recommendation thresholds (recommended default values)
RECOMMENDATION_MIN_CONFIDENCE=30
RECOMMENDATION_HIGH_URGENCY_CHURN_SCORE=70
RECOMMENDATION_MIN_SIMILARITY_SCORE=0.75
RECOMMENDATION_CACHE_EXPIRATION_HOURS=6


# ================================================================
#  SKILL SERVICE  [exposed port: 8097]
# ================================================================

SKILL_DB_URL=jdbc:mysql://mysql:3306/dev_skill?createDatabaseIfNotExist=true
SKILL_DB_USERNAME=root
SKILL_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>
# Absolute or relative path to the uploaded files storage folder
UPLOAD_DIR=./uploads


# ================================================================
#  PROJECT SERVICE  [exposed port: 8098]
# ================================================================

PROJECT_DB_URL=jdbc:mysql://mysql:3306/dev_project?createDatabaseIfNotExist=true
PROJECT_DB_USERNAME=root
PROJECT_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  APPLICATION SERVICE  [exposed port: 8099]
# ================================================================

APPLICATION_DB_URL=jdbc:mysql://mysql:3306/dev_application?createDatabaseIfNotExist=true
APPLICATION_DB_USERNAME=root
APPLICATION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  EVENT SERVICE  [exposed port: 8100]
# ================================================================

EVENT_DB_URL=jdbc:mysql://mysql:3306/dev_event?createDatabaseIfNotExist=true
EVENT_DB_USERNAME=root
EVENT_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  ACTIVITY SERVICE  [exposed port: 8101]
# ================================================================

ACTIVITY_DB_URL=jdbc:mysql://mysql:3306/dev_activity?createDatabaseIfNotExist=true
ACTIVITY_DB_USERNAME=root
ACTIVITY_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>


# ================================================================
#  REGISTRATION SERVICE  [exposed port: 8102]
# ================================================================

INSCRIPTION_DB_URL=jdbc:mysql://mysql:3306/dev_inscription?createDatabaseIfNotExist=true
INSCRIPTION_DB_USERNAME=root
INSCRIPTION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>

# Can be the same Gmail account as MAIL_USERNAME above
INSCRIPTION_MAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
INSCRIPTION_MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD_16_CHARS>


# ================================================================
#  RECOMMENDATION SERVICE  [exposed port: 8103]
# ================================================================

RECOMMENDATION_DB_URL=jdbc:mysql://mysql:3306/dev_recommandation?createDatabaseIfNotExist=true
RECOMMENDATION_DB_USERNAME=root
RECOMMENDATION_DB_PASSWORD=<SAME_AS_MYSQL_ROOT_PASSWORD>
# URL of the Python engine (FastAPI/Flask) — start separately
RECOMMENDATION_ENGINE_URL=http://localhost:8000


# ================================================================
#  ADS SERVICE  [exposed port: 8090]  —  uses PostgreSQL (not MySQL)
# ================================================================

# PostgreSQL dedicated to ads-service
ADS_DB_USER=<CHOOSE_A_USERNAME>
ADS_DB_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>
ADS_DB_NAME=ads_db

# Kafka — internal Docker broker
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Qdrant — vector database for RAG
QDRANT_URL=http://qdrant:6333

# Ollama — local AI models (started automatically via Docker Compose)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama-guard3:1b
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_LLM_MODEL=phi3:mini
RAG_SEARCH_TOP_K=5


# ================================================================
#  MONITORING — Grafana  [port: 3000]
# ================================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>


# ================================================================
#  MONITORING — SonarQube  [port: 9001]
# ================================================================

SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>


# ================================================================
#  ADS — PgAdmin  [port: 5050]
# ================================================================

PGADMIN_DEFAULT_EMAIL=<YOUR_ADMIN_EMAIL>
PGADMIN_DEFAULT_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>


# ================================================================
#  FRONTEND Angular  [port: 4200]
# ================================================================

FRONTEND_API_URL=http://localhost:8222
